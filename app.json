    "en": "Frisquet Connect",
    "fr": "Frisquet Connect"
  },
  "description": {
    "en": "Heating and hot water that fit your day",
    "fr": "Un chauffage et une eau chaude à votre rythme"
  },
  "brandColor": "#28529B",
