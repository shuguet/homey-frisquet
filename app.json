          "id": "auto",
          "title": {
            "en": "Schedule",
            "fr": "Programmation"
          }
        },
        {
          "id": "comfort",
          "title": {
            "en": "Comfort always",
            "fr": "Confort permanent"
          }
        },
        {
          "id": "reduced",
          "title": {
            "en": "Reduced always",
            "fr": "Réduit permanent"
          }
        },
        {
          "id": "frost",
          "title": {
            "en": "Frost protection",
            "fr": "Hors gel"
          }
        },
        {
          "id": "boost",
          "title": {
            "en": "Boost",
            "fr": "Boost"
          }
        }
      ]
