  "flow": {
    "actions": [
      {
        "id": "set_zone_mode",
        "title": {
          "en": "Set heating mode",
          "fr": "Régler le mode de chauffage"
        },
        "titleFormatted": {
          "en": "[[device]]: Set heating mode to [[mode]]",
          "fr": "[[device]]: Régler le chauffage sur [[mode]]"
        },
        "hint": {
          "en": "Schedule also cancels temporary overrides across the installation. Frost protection keeps the boiler powered.",
          "fr": "Programmation annule aussi les dérogations temporaires de l’installation. Hors gel conserve la chaudière alimentée."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "capabilities=frisquet_mode"
          },
          {
            "name": "mode",
            "type": "dropdown",
            "values": [
              {
                "id": "auto",
                "title": {
                  "en": "Schedule",
                  "fr": "Programmation"
                }
              },
              {
                "id": "comfort",
                "title": {
                  "en": "Comfort always",
                  "fr": "Confort permanent"
                }
              },
              {
                "id": "reduced",
                "title": {
                  "en": "Reduced always",
                  "fr": "Réduit permanent"
                }
              },
              {
                "id": "frost",
                "title": {
                  "en": "Frost protection",
                  "fr": "Hors gel"
                }
              },
              {
                "id": "boost",
                "title": {
                  "en": "Boost",
                  "fr": "Boost"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "set_profile_temperature",
        "title": {
          "en": "Set profile temperature",
          "fr": "Régler la température d’un profil"
        },
        "titleFormatted": {
          "en": "[[device]]: Set [[profile]] to [[temperature]] °C",
          "fr": "[[device]]: Régler [[profile]] à [[temperature]] °C"
        },
        "hint": {
          "en": "Changes the stored profile temperature, including future scheduled periods. Does not switch the active profile.",
          "fr": "Modifie la consigne enregistrée, y compris pour les prochaines plages. Ne change pas le profil actif."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "capabilities=frisquet_mode"
          },
          {
            "name": "profile",
            "type": "dropdown",
            "values": [
              {
                "id": "comfort",
                "title": {
                  "en": "Comfort",
                  "fr": "Confort"
                }
              },
              {
                "id": "reduced",
                "title": {
                  "en": "Reduced",
                  "fr": "Réduit"
                }
              },
              {
                "id": "frost",
                "title": {
                  "en": "Frost protection",
                  "fr": "Hors gel"
                }
              }
            ]
          },
          {
            "name": "temperature",
            "type": "number",
            "title": {
              "en": "Temperature",
              "fr": "Température"
            },
            "min": 5,
            "max": 25,
            "step": 0.5
          }
        ]
      },
      {
        "id": "set_hot_water_mode",
        "title": {
          "en": "Set hot-water mode",
          "fr": "Régler le mode eau chaude"
        },
        "titleFormatted": {
          "en": "[[device]]: Set hot-water mode to [[mode]]",
          "fr": "[[device]]: Régler l’eau chaude sur [[mode]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "capabilities=frisquet_water_mode"
          },
          {
            "name": "mode",
            "type": "autocomplete",
            "title": {
              "en": "Mode",
              "fr": "Mode"
            },
            "placeholder": {
              "en": "Choose a supported mode",
              "fr": "Choisir un mode disponible"
            }
          }
        ]
      },
      {
        "id": "set_installation_override",
        "title": {
          "en": "Set installation override",
          "fr": "Régler la dérogation générale"
        },
        "titleFormatted": {
          "en": "Set scheduled zones to [[mode]]",
          "fr": "Régler les zones programmées sur [[mode]]"
        },
        "hint": {
          "en": "Applies to the installation's scheduled zones until the next programme change. Schedule cancels the override.",
          "fr": "S’applique aux zones programmées de l’installation jusqu’à la prochaine plage. Programmation annule la dérogation."
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=boiler"
          },
          {
            "name": "mode",
            "type": "dropdown",
            "values": [
              {
                "id": "auto",
                "title": {
                  "en": "Schedule",
                  "fr": "Programmation"
                }
              },
              {
                "id": "comfort",
                "title": {
                  "en": "Comfort temporarily",
                  "fr": "Confort temporaire"
                }
              },
              {
